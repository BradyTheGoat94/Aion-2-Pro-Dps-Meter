<Window x:Class="Aion2DPSPro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aion2DPSPro — LIVE DIAGNOSTIC" Width="900" Height="570" Background="#0A0E16" Foreground="#F3F6FF">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="AION 2 DPS — LIVE DIAGNOSTIC" FontSize="24" FontWeight="Bold"/>
    <TextBlock Text="NO SIMULATED DATA — values remain zero until live packets decode" Foreground="#FF6B6B" FontWeight="SemiBold"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="OPEN OVERLAY" Margin="6" Padding="12,6" Click="OpenOverlay"/>
    <Button Content="RESET FIGHT" Margin="6" Padding="12,6" Click="Reset"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border Background="#121925" CornerRadius="10" Padding="14" Margin="0,0,8,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="LIVE COMBAT ONLY" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" Background="#121925" Foreground="#F3F6FF" BorderThickness="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="35"/>
       <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="DPS" Binding="{Binding Dps}" Width="85"/>
       <DataGridTextColumn Header="Damage" Binding="{Binding Damage}" Width="100"/>
       <DataGridTextColumn Header="Share" Binding="{Binding Share}" Width="70"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <StackPanel Grid.Column="1" Margin="8,0,0,0">
    <Border Background="#121925" CornerRadius="10" Padding="14" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="CURRENT FIGHT" Foreground="#9AA8C2"/>
      <TextBlock x:Name="Dps" Text="0 DPS" FontSize="34" FontWeight="Bold"/>
      <TextBlock x:Name="Damage" Text="0 damage"/>
      <TextBlock x:Name="Target" Text="No target" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border Background="#121925" CornerRadius="10" Padding="14">
     <StackPanel>
      <TextBlock Text="LIVE PIPELINE" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="LATEST DECODED EVENT" Foreground="#9AA8C2" Margin="0,8,0,2"/><TextBlock x:Name="LatestEvent" Text="None yet" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#F3F6FF"/><TextBlock x:Name="SnapshotState" Text="Snapshot #0 | FightDamage=0 | FightDPS=0" TextWrapping="Wrap" Foreground="#9AA8C2" Margin="0,6,0,6"/><TextBlock Text="VALIDATION LOG" Foreground="#9AA8C2" Margin="0,4,0,2"/><TextBlock x:Name="ValidationFile" Text="Waiting for first recognized event..." TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"/>
      <TextBlock x:Name="Status" Text="Starting..." TextWrapping="Wrap" Margin="0,6,0,10"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <TextBlock Text="TCP packets captured"/><TextBlock x:Name="PacketCount" Grid.Column="1" Text="0" FontWeight="Bold"/>
       <TextBlock Grid.Row="1" Text="Decoder diagnostics"/><TextBlock x:Name="DiagnosticCount" Grid.Row="1" Grid.Column="1" Text="0" FontWeight="Bold"/>
       <TextBlock Grid.Row="2" Text="Recognized parses"/><TextBlock x:Name="RecognizedCount" Grid.Row="2" Grid.Column="1" Text="0" FontWeight="Bold"/>
       <TextBlock Grid.Row="3" Text="Combat events emitted"/><TextBlock x:Name="EventCount" Grid.Row="3" Grid.Column="1" Text="0" FontWeight="Bold"/></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Duplicates suppressed"/><TextBlock x:Name="DuplicateCount" Grid.Column="1" Text="0" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Engine accepted damage"/><TextBlock x:Name="AcceptedDamageCount" Grid.Row="1" Grid.Column="1" Text="0" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Damage events"/><TextBlock x:Name="DamageEventCount" Grid.Row="1" Grid.Column="1" Text="0" FontWeight="Bold"/><TextBlock Grid.Row="2" Text="Heal events"/><TextBlock x:Name="HealEventCount" Grid.Row="2" Grid.Column="1" Text="0" FontWeight="Bold"/><TextBlock Grid.Row="3" Text="HP events"/><TextBlock x:Name="HpEventCount" Grid.Row="3" Grid.Column="1" Text="0" FontWeight="Bold"/><TextBlock Grid.Row="4" Text="Other events"/><TextBlock x:Name="OtherEventCount" Grid.Row="4" Grid.Column="1" Text="0" FontWeight="Bold"/>
      </Grid>
      <TextBlock Text="Locked adapter / flow" Foreground="#9AA8C2" Margin="0,12,0,2"/><TextBlock x:Name="ActiveFlow" Text="Waiting..." TextWrapping="Wrap"/><TextBlock Text="Protocol profile" Foreground="#9AA8C2" Margin="0,12,0,2"/>
      <TextBlock x:Name="Profile" Text="-" TextWrapping="Wrap"/><TextBlock Text="LAST DECODED EVENT" Foreground="#9AA8C2" Margin="0,10,0,2"/><TextBlock x:Name="LastEvent" Text="None yet" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#F3F6FF"/>
      <TextBlock Text="Last decoder message" Foreground="#9AA8C2" Margin="0,12,0,2"/>
      <TextBlock x:Name="LastDecoder" Text="Waiting for traffic..." TextWrapping="Wrap"/><TextBlock Text="Decoded event inspector" Foreground="#9AA8C2" Margin="0,12,0,2"/><TextBox x:Name="EventInspector" Height="145" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0A0E16" Foreground="#F3F6FF" BorderBrush="#263B5E" FontFamily="Consolas" FontSize="11"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>
 </Grid>
</Window>





