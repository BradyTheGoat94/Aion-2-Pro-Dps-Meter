<Window x:Class="Aion2DPSPro.Overlay.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Aion2DPSPro.Overlay"
 AllowsTransparency="True" Background="Transparent" WindowStyle="None" Topmost="True" ShowInTaskbar="False"
 ResizeMode="CanResizeWithGrip" Width="720" Height="520" MinWidth="540" MinHeight="360">
 <Window.Resources>
    <icons:ClassIconConverter x:Key="ClassIconConverter"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F7FF"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#14284A"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#2F80ED"/><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="3,0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#D9E8FF"/><Setter Property="Background" Value="#0E1C35"/><Setter Property="BorderBrush" Value="#2F80ED"/><Setter Property="Padding" Value="12,5"/></Style>
 </Window.Resources>
 <Border x:Name="Root" Background="#F20A1630" BorderBrush="#E53935" BorderThickness="1.4" CornerRadius="9" MouseLeftButtonDown="Drag">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#101F3D" CornerRadius="8,8,0,0" BorderBrush="#2F80ED" BorderThickness="0,0,0,1">
    <DockPanel Margin="12,0">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="AION 2" FontSize="20" FontWeight="Bold" Foreground="#8FB8FF"/><TextBlock Text="  DPS" FontSize="20" FontWeight="Bold" Foreground="#FF4D5A"/><Border x:Name="PreviewBadge" Background="#A8322630" CornerRadius="4" Margin="12,0,0,0" Padding="7,2"><TextBlock Text="SIMULATED PREVIEW" FontWeight="Bold" Foreground="#FFB3B8" FontSize="11"/></Border></StackPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="GroupDps" Foreground="#8FB8FF" Margin="0,0,14,0"/><TextBlock x:Name="Timer" Text="00:00" FontWeight="SemiBold"/><Button Content="⚙" Click="ToggleOptions"/><Button Content="×" Click="CloseOverlay"/></StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1" Margin="10,5,10,3">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"><TabItem Header="Damage"/><TabItem Header="Healing"/><TabItem Header="Damage Taken"/><TabItem Header="Buffs"/><TabItem Header="Combat Log"/></TabControl>
    <ComboBox x:Name="Segment" Grid.Column="1" Width="130" Height="28" SelectedIndex="0" Background="#14284A" Foreground="White"><ComboBoxItem Content="Current Fight"/><ComboBoxItem Content="Overall"/></ComboBox>
   </Grid>
   <Grid Grid.Row="2" Margin="12,4,12,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <ListView x:Name="Rows" Background="#5A081326" BorderBrush="#284E7D" Foreground="#F4F7FF" SelectionChanged="PlayerSelected">
     <ListView.ItemTemplate><DataTemplate><Grid Height="42" Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#8FB8FF"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding Brush}"/><StackPanel Orientation="Horizontal"><Image Width="14" Height="14" Margin="0,0,4,0" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"/><TextBlock Text="{Binding ClassName}"/></StackPanel></StackPanel>
      <Grid Grid.Column="2" Margin="8,8"><Border Background="#1B2B4D" CornerRadius="3"/><Border Background="{Binding Brush}" Opacity="0.82" HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3"/></Grid>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding Dps}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Damage}" HorizontalAlignment="Right" FontSize="10" Foreground="#AFC9EF"/></StackPanel>
      <TextBlock Grid.Column="4" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{Binding Brush}"/>
     </Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Border Grid.Column="2" Background="#70081326" BorderBrush="#284E7D" BorderThickness="1" CornerRadius="6" Padding="10">
     <StackPanel><TextBlock Text="PLAYER DETAILS" Foreground="#8FB8FF" FontWeight="Bold"/><TextBlock x:Name="SelectedPlayer" Text="Select a player" FontSize="18" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock x:Name="SelectedMeta" Foreground="#AFC9EF"/>
      <Separator Margin="0,10" Background="#284E7D"/><TextBlock Text="Top Skills" FontWeight="Bold"/><ItemsControl x:Name="Skills" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Damage}" HorizontalAlignment="Right" Foreground="#FF8790"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Row="3" Background="#101F3D" BorderBrush="#284E7D" BorderThickness="0,1,0,0" Padding="12,6" CornerRadius="0,0,8,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TargetName" Text="No target" FontWeight="Bold"/><ProgressBar x:Name="BossHp" Height="9" Minimum="0" Maximum="100" Foreground="#E53935" Background="#1B2B4D" Margin="0,5,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="TargetHp" HorizontalAlignment="Right" Foreground="#FF8790"/><TextBlock x:Name="StatusText" HorizontalAlignment="Right" Margin="0,4,0,0" Foreground="#8FB8FF"/></StackPanel></Grid>
   </Border>
  </Grid>
 </Border>
</Window>

